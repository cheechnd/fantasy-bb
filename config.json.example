{
  "app_dir": "~/.fantasy-baseball",
  "db_path": "~/.fantasy-baseball/fb.db",
  "log_level": "info",
  "environment": "development",
  "league": {
    "platform": "espn",
    "league_id": "",
    "team_id": "",
    "season": 2026
  },
  "auth": {
    "espn_s2_env": "ESPN_S2",
    "swid_env": "ESPN_SWID"
  },
  "espn": {
    "base_url": "https://lm-api-reads.fantasy.espn.com",
    "timeout_seconds": 20
  },
  "planning": {
    "pitchers": {
      "auto_start_min_total_fpts": 20.0,
      "likely_start_min_total_fpts": 12.0,
      "monitor_min_total_fpts": 6.0,
      "tbd_penalty": 3.0,
      "missing_projection_penalty": 4.0,
      "ambiguous_match_penalty": 5.0
    }
  },
  "pickups": {
    "pitchers": {
      "default_candidate_limit": 25,
      "max_candidate_limit": 50,
      "min_streamer_total_fpts": 8.0,
      "strong_upgrade_delta_fpts": 5.0,
      "marginal_upgrade_delta_fpts": 1.5,
      "risky_monitor_min_total_fpts": 6.0
    }
  },
  "transactions": {
    "pitchers": {
      "top_move_limit": 10,
      "max_pairings": 25,
      "strong_move_delta_fpts": 5.0,
      "marginal_move_delta_fpts": 1.5,
      "risky_move_min_delta_fpts": 0.5,
      "uncertainty_penalty_tbd": 2.0,
      "uncertainty_penalty_missing_projection": 3.0,
      "uncertainty_penalty_ambiguous_match": 4.0,
      "allow_compare_against_likely_start": false
    },
    "ad_hoc": {
      "enabled": true,
      "max_recent_requests": 25,
      "require_pitchers_only": true,
      "reuse_bounded_candidate_limit": 25
    }
  },
  "lineup": {
    "pitchers": {
      "enabled": true,
      "auto_generate_from_pitcher_plan": true,
      "allow_monitor_actions": false,
      "require_confirmation": true,
      "block_on_ambiguous_slot_mapping": true
    }
  },
  "monitoring": {
    "plans_stale_hours": 12,
    "lineup_stale_hours": 4,
    "pickups_stale_hours": 6,
    "candidate_pool_stale_hours": 4,
    "approval_stale_hours": 2,
    "execution_followup_hours": 1,
    "require_live_recheck_for_approved_items": true
  },
  "execution": {
    "dry_run": true,
    "require_confirmation": true,
    "preflight": {
      "default_limit": 10,
      "max_limit": 25,
      "candidate_refresh_limit": 25,
      "stale_hours_threshold": 12,
      "require_live_roster_check": true,
      "require_live_availability_check": true
    },
    "real": {
      "enabled": false,
      "require_confirmation": true,
      "allow_repeat_execution": false,
      "verification_timeout_seconds": 20
    },
    "hardening": {
      "block_on_prior_success": true,
      "block_on_ambiguous_prior_attempt": true,
      "verification_recheck_limit": 3,
      "verification_pending_window_seconds": 30,
      "treat_mixed_reconciliation_as_inconclusive": true
    }
  },
  "features": {
    "enable_write_actions": false,
    "enable_browser_automation": false,
    "enable_llm_explanations": false
  }
}
